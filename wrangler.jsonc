// Cloudflare Workers の設定ファイル。
// 公開に必要な値は設定済み。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "reipay",
  "main": "server/index.js",
  "compatibility_date": "2026-11-11",

  // 画面のファイル（HTML/CSS/JS/画像）は public/ だけを公開する。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reipay-db",
      // Cloudflare で作った D1 データベースの「Database ID」
      "database_id": "dd594a39-2ce4-4524-b321-e04de2c697a9",
    },
  ],

  // ダッシュボードで登録した値を、公開のたびに消さないようにする
  "keep_vars": true,
}
